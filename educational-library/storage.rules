rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    match /books/{bookId}/{file} {
      allow read: if true;
      allow write: if isAdmin() && (
        request.resource == null ||
        (request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)') && request.resource.size < 60 * 1024 * 1024));
    }
  }
}
